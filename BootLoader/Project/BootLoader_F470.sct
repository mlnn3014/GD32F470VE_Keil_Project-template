; BootLoader: 0x08000000 - 0x0800FFFF

LR_IROM1 0x08000000 0x00010000  {
  ER_IROM1 0x08000000 0x00010000  {
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
   .ANY (+XO)
  }
  RW_IRAM1 0x20000000 0x00030000  {
   .ANY (+RW +ZI)
  }
  ER_IRAM_FUNC +0  {
   *.o (.ramfunc)
   gd32f4xx_fmc.o (+RO)
   onchip_flash_bsp.o (+RO)
  }
}
